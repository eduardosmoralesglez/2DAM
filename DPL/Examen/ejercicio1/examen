server {
	listen 80 default;
	listen 8080;
	root /var/www/examen;	
	location / {
		index index.html;
		try_files $uri $uri/ =404;
	}
	location /html {
		include mime.types;
		types {
			text/html	dpl;
		}
		index index.dpl index.html index.htm;
		try_files $uri $uri/ =404;
	}
	location = / {
		try_files /html/index.html /index.html =404;
	}
	location ~ \.png {
		try_files /html/foto.jpg =404;
	}
}
server {
	listen 80;
	root /var/www/examen/html;
	server_name www.angelmelchor.pro;
	location / {
		index index.html;
		try_files $uri $uri/ =404;		
	}
}







